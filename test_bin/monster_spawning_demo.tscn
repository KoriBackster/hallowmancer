[sub_resource type="GDScript" id="GDScript_5s8ec"]
script/source = "extends Node2D
@onready var marker := $Marker2D

@onready var monster_spawn_options:OptionButton = $MonsterSpawning

func _ready() -> void:
	#print(Monster2D.getMonsterList())
	monster_spawn_options.pressed.connect(func():
		monster_spawn_options.clear()
		var available_monsters:= Monster2D.getMonsterList()
		for title in available_monsters:
			monster_spawn_options.add_item(title.to_pascal_case())
		
		monster_spawn_options.select(-1)
		)
		
	
	monster_spawn_options.item_selected.connect(func(v):
		for ch in get_tree().root.find_children(\"\", \"Monster2D\", true, false):
			#print(ch.name)
			ch.queue_free()
		var selected_monster_name:= monster_spawn_options.get_item_text(v)
		
		example_of_manually_creating_a_monster_by_their_tag(selected_monster_name)
		
		)

func example_of_creating_a_monster_via_macro(tag:StringName)->void:
	# The monster tag would be irrelavent in the case of spawning as it is handled by the macro.
	# the function simply takes the tag to make intent clear
	tag = tag.to_snake_case()
	
	var new_monster:Monster2D
	# Example of spawning a monster using the macro
	match tag:
		\"zombie\":
			new_monster = Monster2D.newZombie()
		\"gremlin\":
			new_monster = Monster2D.newGremlin()
	
	new_monster.global_position = marker.global_position
	add_child(new_monster)
	

func example_of_manually_creating_a_monster_by_their_tag(tag:StringName)->void:
	# The monster name needs to be identical to the monster's folder name...
	# the monster's folder name is always snake_case; see String.to_snake_case()
	tag = tag.to_snake_case()
	# Example of spawning a monster manually using their tag
	var new_monster:Monster2D = Monster2D.MONSTER_BASE_SCENE.instantiate()
	new_monster._set_config_by_tag(tag)
	
	#var inherited_scene_path := Monster2D.MONSTER_DIR.path_join(\"monster_base.tscn\")
	#var new_scene_path := Monster2D.MONSTER_DIR.path_join(tag).path_join(\"scene.tscn\")

	#var scene_text := \"\"\"
	#[gd_scene load_steps=2 format=3]
#
	#[ext_resource type=\"PackedScene\" path=\"%s\" id=\"1\"]
#
	#[node name=\"%s\" instance=ExtResource(\"1\")]
	#\"\"\" % [inherited_scene_path, tag.to_pascal_case()]
#
	#var file := FileAccess.open(new_scene_path, FileAccess.WRITE)
#
	#if file:
		#file.store_string(scene_text)
		#file.close()
	#
	#var n_m = load(Monster2D.MONSTER_DIR.path_join(tag).path_join(\"scene.tscn\")) as PackedScene
	#n_m = n_m.instantiate(PackedScene.GEN_EDIT_STATE_MAIN_INHERITED)
	##n_m.active_data = ResourceLoader.load(Monster2D.MONSTER_DIR.path_join(tag).path_join(\"data.tscn\"), \"MonsterData\")
	#n_m._set_config_by_tag(tag)
	#var custom_scene:=PackedScene.new()
	#custom_scene.pack(new_monster)
	##custom_scene.
	#ResourceSaver.save(custom_scene, Monster2D.MONSTER_DIR.path_join(tag).path_join(\"scene.tscn\"))
	
	new_monster.global_position = marker.global_position
	add_child(new_monster)
"

