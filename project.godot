; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hallowmancer"
run/main_scene="uid://bmtyrvpc7qaae"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.8862745, 0.41960785, 0.07450981, 1)
boot_splash/use_filter=false
boot_splash/image="uid://cqrtntoe1gg4l"
config/icon="res://icon.svg"
boot_splash/minimum_display_time=2000

[autoload]

Config="*uid://ds0cercswx51"
SignalBus="*uid://npk4hfmmwkd7"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://Components/": "green",
"res://Fonts/": "orange",
"res://Resources/": "yellow",
"res://Scenes/": "red",
"res://Shaders/": "purple",
"res://raw/": "teal"
}

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/default_font_generate_mipmaps=true
theme/custom="res://raw/themes/glyph_state_micro_theme.tres"
theme/custom_font="res://raw/fonts/glyphstate_micro.tres"

[input]

move={
